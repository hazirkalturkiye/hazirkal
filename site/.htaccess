# Hazırkal: GoDaddy / Apache güvenlik ve önbellek ayarları
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType image/svg+xml .svg
AddType font/woff2 .woff2
AddType image/webp .webp
AddType application/vnd.android.package-archive .apk

# Gizli dosya ve klasörlere erişim yok (.git, .env, .htaccess vb.); yalnızca .well-known açık (security.txt, SSL doğrulaması)
RedirectMatch 404 "/\.(?!well-known/)"
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Yalnızca form dosyası PHP olarak çalışabilir; yedek, kayıt ve hata dosyaları dışarı verilmez
<FilesMatch "(^error_log$|\.(php\d*|pht|phtml|phar|phps|inc|bak|old|orig|log|sql|zip)$|~$)">
  Require all denied
</FilesMatch>
<Files "gonder.php">
  Require all granted
  LimitRequestBody 65536
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Her şey https://hazirkal.com adresine (www, http ve hazirkal.aikidofestival.com dahil). SSL doğrulaması için .well-known hariç.
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^hazirkal\.com$ [NC]
  RewriteRule ^ https://hazirkal.com%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  <FilesMatch "\.(woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(css)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.apk$">
    Header set Content-Disposition "attachment"
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
